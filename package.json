{
  "name": "omp-antigravity",
  "version": "0.8.2",
  "description": "Google Antigravity (Cloud Code Assist) provider and image generation for Oh My Pi (OMP).",
  "author": "Rahul Arya",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "keywords": [
    "omp-package",
    "omp-extension",
    "oh-my-pi",
    "antigravity",
    "google",
    "oauth",
    "provider",
    "cloud-code-assist"
  ],
  "files": [
    "LICENSE",
    "README.md",
    "src",
    "tsconfig.json"
  ],
  "packageManager": "bun@1.4.0",
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "bun test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run typecheck && bun run lint && bun run test && bun run format:check"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": ">=18.0.0",
    "@oh-my-pi/pi-coding-agent": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@oh-my-pi/omptype": "^18.8.3",
    "@oh-my-pi/pi-ai": "^18.8.3",
    "@oh-my-pi/pi-coding-agent": "^18.8.3",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1"
  }
}
